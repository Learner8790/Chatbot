# API Configuration for Comprehensive Validation
# ==============================================
#
# Copy this file to .env and fill in your API key
# Run: cp .env.example .env

# OPTION 1 (Recommended): Use Claude/Anthropic API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OPTION 2: Use OpenAI API
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Model Selection (optional)
# For Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, etc.
# For OpenAI: gpt-4, gpt-3.5-turbo, etc.
# LLM_MODEL=claude-3-5-sonnet-20241022
