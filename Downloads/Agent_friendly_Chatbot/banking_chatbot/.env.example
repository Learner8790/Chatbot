# Banking Chatbot Environment Variables
# Copy this file to .env and fill in your values

# ===================
# REQUIRED
# ===================

# Anthropic API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key-here

# ===================
# OPTIONAL
# ===================

# Application
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Database (defaults to SQLite)
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./banking_chatbot.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# LLM Settings
DEFAULT_MODEL=claude-sonnet-4-20250514
FALLBACK_MODEL=claude-haiku-4-20250514
MAX_TOKENS=150
TEMPERATURE=0

# Routing Thresholds
CONFIDENCE_THRESHOLD=0.7
ESCALATION_THRESHOLD=0.4

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Escalation Notifications
ESCALATION_EMAIL=support@yourcompany.com
ESCALATION_WEBHOOK=https://your-webhook-url.com/escalation

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# OpenAI API Key (optional, for fallback)
OPENAI_API_KEY=
