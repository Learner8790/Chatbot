# Banking Chatbot Dashboard - Streamlit
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    streamlit==1.31.0 \
    plotly==5.18.0 \
    pandas==2.2.0 \
    httpx==0.26.0

# Copy dashboard code
COPY app/dashboard ./app/dashboard

# Create non-root user
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

CMD ["streamlit", "run", "app/dashboard/admin.py", "--server.port=8501", "--server.address=0.0.0.0"]
